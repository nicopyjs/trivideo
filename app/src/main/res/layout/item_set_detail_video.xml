<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="88dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:background="#33FFFFFF"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvVideoName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="middle" />

    <ImageButton
        android:id="@+id/btnRenameVideo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_edit_24"
        android:contentDescription="@string/rename_video_title"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/btnFavoriteVideo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_star_border_24"
        android:contentDescription="@string/favorite_move_action"
        app:tint="@color/text_secondary" />

</LinearLayout>
