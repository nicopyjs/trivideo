<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/control_panel_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Grabber + cronómetro -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:background="@drawable/panel_grabber" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/timer_pill_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:text="@string/session_timer_initial" />

        </FrameLayout>

        <!-- Transporte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/btnMuteAll"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_btn_bg"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_volume_off_24"
                android:contentDescription="@string/mute_all"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/play_fab_bg"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_pause_24"
                android:contentDescription="@string/play_pause"
                app:tint="@color/on_brand_violet" />

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_btn_bg"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_lock_24"
                android:contentDescription="@string/lock_controls"
                app:tint="@color/text_primary" />

        </LinearLayout>

        <!-- Volumen del panel activo -->
        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:max="100" />

        <!-- Modo -->
        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/section_mode" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModePool"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_pool_label"
                app:icon="@drawable/ic_shuffle_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeFixed"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mode_fixed_label"
                app:icon="@drawable/ic_grid_2x2_24"
                app:iconGravity="textStart" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Categorías -->
        <LinearLayout
            android:id="@+id/categorySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:textColor="@color/text_secondary"
                android:text="@string/section_categories" />

            <HorizontalScrollView
                android:id="@+id/categoryFilterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categoryFilterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="false"
                    app:chipSpacingHorizontal="8dp" />

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPoolCategory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_shuffle_24"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/control_idle_stroke"
                android:text="@string/pool_by_category" />

        </LinearLayout>

        <!-- Velocidad -->
        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/section_speed" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/speedChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed050"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.5×" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed075"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.75×" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed100"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1×" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed125"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.25×" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed150"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.5×" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpeed200"
                    style="@style/Widget.TriVideo.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2×" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Distribución -->
        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/section_layout" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/layoutToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLayoutAuto"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/layout_auto"
                app:icon="@drawable/ic_grid_auto_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLayoutCol"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/layout_one_col"
                app:icon="@drawable/ic_grid_col_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLayoutRow"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/layout_one_row"
                app:icon="@drawable/ic_grid_row_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLayoutGrid"
                style="@style/Widget.TriVideo.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:contentDescription="@string/layout_grid"
                app:icon="@drawable/ic_grid_2x2_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Auto-rotación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:text="@string/section_autorotate" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rotateChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRot15"
                style="@style/Widget.TriVideo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRot30"
                style="@style/Widget.TriVideo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRot60"
                style="@style/Widget.TriVideo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRot120"
                style="@style/Widget.TriVideo.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120s" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Acciones -->
        <TextView
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/section_actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickFolder"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/control_idle_stroke"
                android:text="@string/random_button_short" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeVideos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/control_idle_stroke"
                android:text="@string/change_videos" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSets"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/control_idle_stroke"
                android:text="@string/sets_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSet"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/control_idle_stroke"
                android:text="@string/save_current_set" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
