<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="texture_view" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone" />

    <TextView
        android:id="@+id/labelFilename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/label_background"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/holdBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/label_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="11sp"
        android:text="@string/panel_held_badge"
        android:visibility="gone" />

    <View
        android:id="@+id/activeBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_active_border"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/circle_btn_bg"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/ic_star_border_24"
        android:alpha="0.5"
        android:contentDescription="@string/favorite_move_action"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/categoryButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCatCu"
                style="@style/CategoryPanelButton"
                android:contentDescription="@string/cat_cu_desc"
                android:text="@string/cat_cu_short" />

            <TextView
                android:id="@+id/btnCatOr"
                style="@style/CategoryPanelButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/cat_or_desc"
                android:text="@string/cat_or_short" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCatAn"
                style="@style/CategoryPanelButton"
                android:contentDescription="@string/cat_an_desc"
                android:text="@string/cat_an_short" />

            <TextView
                android:id="@+id/btnCatTt"
                style="@style/CategoryPanelButton"
                android:contentDescription="@string/cat_tt_desc"
                android:text="@string/cat_tt_short" />

            <TextView
                android:id="@+id/btnCatCs"
                style="@style/CategoryPanelButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/cat_cs_desc"
                android:text="@string/cat_cs_short" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
