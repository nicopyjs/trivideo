<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TriVideo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>

        <!-- Marca: los componentes Material toman estos tokens -->
        <item name="colorPrimary">@color/brand_violet</item>
        <item name="colorPrimaryDark">@color/brand_violet_pressed</item>
        <item name="colorOnPrimary">@color/on_brand_violet</item>
        <item name="colorSecondary">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/on_brand_violet</item>
        <item name="colorSecondaryContainer">@color/brand_violet</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_violet</item>
    </style>

    <!-- Chip de opción (velocidad, intervalos) -->
    <style name="Widget.TriVideo.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/sel_chip_bg</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="chipStrokeColor">@color/sel_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- Botón dentro de un MaterialButtonToggleGroup (modo, distribución) -->
    <style name="Widget.TriVideo.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:backgroundTint">@color/sel_toggle_bg</item>
        <item name="android:textColor">@color/sel_toggle_text</item>
        <item name="iconTint">@color/sel_toggle_text</item>
        <item name="strokeColor">@color/sel_chip_stroke</item>
    </style>

    <!-- Botoncito redondo de categoría en cada panel (como la estrella) -->
    <style name="CategoryPanelButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/circle_btn_bg</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:alpha">0.5</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
